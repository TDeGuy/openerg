{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "autoIncrement": true,
      "env": { "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a" }
    },
    "emulator": {
      "extends": "preview",
      "autoIncrement": false,
      "env": { "ORG_GRADLE_PROJECT_reactNativeArchitectures": "x86_64" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a" }
    }
  },
  "submit": {
    "production": {}
  }
}
